APP_NAME=Personalized AI Assistant
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# Configure both to enable /assistant; generate unique values as described in README.
# AUTH_TOKEN=
# AUTH_USER_ID=

# Required for live generation. OPENAI_MODEL is the fallback when the profile has no model.
# OPENAI_API_KEY=
# OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2048
# Explicit model-name -> budget JSON. Replace YOUR_MODEL and verify its capacity.
# No model capacity is guessed; sends without a matching entry return 503.
# CONTEXT_MODEL_BUDGETS={"YOUR_MODEL":{"context_window_tokens":8192,"safety_margin_tokens":1024}}
# Optional per-model max_output_tokens overrides OPENAI_MAX_OUTPUT_TOKENS.
CONTEXT_HISTORY_SCAN_LIMIT=10000
GENERATION_LEASE_SECONDS=180
